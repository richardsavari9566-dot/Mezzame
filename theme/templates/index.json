      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do you offer same-day delivery?",
            "answer": "<p>Same-day availability depends on the product, your delivery location and the time you order.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can I customise a celebration cake?",
            "answer": "<p>Yes. Custom celebration cakes need advance notice—message us with your design, size and date.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Are eggless cakes available?",
            "answer": "<p>Yes. Eggless options are marked on each product and can be chosen when you order.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Which areas do you deliver to?",
            "answer": "<p>We deliver across Chennai. Enter your pincode on any product page to check availability.</p>"
          }
        }
