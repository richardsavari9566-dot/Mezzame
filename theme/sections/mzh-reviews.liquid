{%- if section.blocks.size > 0 -%}
  <section class="mzh mzh-section mzh--alt">
    <div class="mzh-container">
      <div class="mzh-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="mzh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
          <h2 class="mzh-title">{{ section.settings.heading }}</h2>
        </div>
      </div>
      <div class="mzh-reviews">
        {%- for block in section.blocks -%}
          <figure class="mzh-quote" {{ block.shopify_attributes }}>
            <div class="mzh-quote__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
            </div>
            <blockquote>{{ block.settings.quote }}</blockquote>
            {%- if block.settings.author != blank -%}<figcaption>{{ block.settings.author }}</figcaption>{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Mezzame reviews",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved at First Slice" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "“The cake looked premium, travelled well and tasted even better than it looked.”" },
        { "type": "text", "id": "author", "label": "Name and order", "default": "Birthday order" }
      ]
    }
  ],
  "presets": [{ "name": "Mezzame reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
