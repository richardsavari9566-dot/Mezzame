{%- comment -%} FAQ with native <details> and FAQPage structured data (tracker T-3-5). {%- endcomment -%}
<section class="mzh mzh-section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="mzh-container mzh-faq">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="mzh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="mzh-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="mzh-copy">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div>
      {%- for block in section.blocks -%}
        <details class="mzh-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="mzh-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Mezzame FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Useful answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before You Order" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do you offer same-day delivery?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Same-day availability depends on the product, delivery location and order time.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Mezzame FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
