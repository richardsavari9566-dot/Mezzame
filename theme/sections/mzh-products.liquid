{%- comment -%}
  Best sellers. Pulls products from the chosen collection; until the catalogue exists
  it falls back to the sample cards defined as blocks (each block can also point at a product).
  The "+" goes to the product page rather than quick-adding, because cakes need a delivery
  date, slot and message chosen on the product page (tracker T-1-3, T-1-4).
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  assign use_collection = false
  if source != blank and source.products_count > 0
    assign use_collection = true
  endif
-%}
<section class="mzh mzh-section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="mzh-container">
    <div class="mzh-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="mzh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="mzh-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="mzh-copy">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        {%- assign view_all = section.settings.link | default: source.url | default: routes.all_products_collection_url -%}
        <a class="mzh-link" href="{{ view_all }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="mzh-grid4">
      {%- if use_collection -%}
        {%- for product in source.products limit: section.settings.limit -%}
          {%- liquid
            assign label = product.metafields.custom.badge.value
            if label == blank and product.compare_at_price > product.price
              assign label = 'Offer'
            endif
          -%}
          {%- render 'mzh-product-card',
            url: product.url,
            image: product.featured_image,
            title: product.title,
            label: label,
            price: product.price_min,
            price_varies: product.price_varies,
            loading: 'lazy'
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- render 'mzh-product-card',
              url: p.url,
              image: p.featured_image,
              title: p.title,
              label: block.settings.label,
              price: p.price_min,
              price_varies: p.price_varies,
              attrs: block.shopify_attributes
            -%}
          {%- else -%}
            {%- render 'mzh-product-card',
              url: block.settings.link,
              image: block.settings.image,
              title: block.settings.title,
              label: block.settings.label,
              price_text: block.settings.price_text,
              attrs: block.shopify_attributes
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mezzame best sellers",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "cakes", "info": "Used by header links such as /#cakes." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Easy entry collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers Under ₹1,500" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "When the collection has products they replace the sample cards below." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all cakes ↗" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the selected collection." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Sample card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. Overrides the sample content below." },
        { "type": "text", "id": "label", "label": "Badge" },
        { "type": "paragraph", "content": "Sample content (used until a product is chosen)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Signature Chocolate Cake" },
        { "type": "text", "id": "price_text", "label": "Price text", "default": "From ₹1,250" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Mezzame best sellers", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
