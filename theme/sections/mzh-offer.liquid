{%- comment -%} Dark offer banner. Hidden when there is no heading. {%- endcomment -%}
{%- if section.settings.heading != blank -%}
  <section class="mzh mzh-section mzh--alt">
    <div class="mzh-container">
      <div class="mzh-offer"{% if section.settings.watermark != blank %} data-watermark="{{ section.settings.watermark | escape }}"{% endif %}>
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="mzh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
          <h3>{{ section.settings.heading }}</h3>
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a class="mzh-btn mzh-btn--light" href="{{ section.settings.button_link | default: '#gifts' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Mezzame offer banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gifting offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complimentary handwritten note" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "watermark", "label": "Background watermark", "default": "20%" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the offer" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Mezzame offer banner" }]
}
{% endschema %}
