{%- if section.settings.heading != blank -%}
  <section class="mzh mzh-section mzh--alt">
    <div class="mzh-container">
      <div class="mzh-cta">
        <div>
          <h3>{{ section.settings.heading }}</h3>
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a class="mzh-btn mzh-btn--dark" href="{{ section.settings.button_link | default: '#cakes' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Mezzame order banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something worth celebrating?" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Order Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Mezzame order banner" }]
}
{% endschema %}
