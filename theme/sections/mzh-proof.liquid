{%- comment -%} "Why Mezzame": image gallery beside proof points. {%- endcomment -%}
{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign points = section.blocks | where: 'type', 'point'
-%}
<section class="mzh mzh-section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="mzh-container mzh-why">
    <div class="mzh-gallery" data-mzh="gallery" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in slides -%}
        <div class="mzh-gallery__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- render 'mzh-image', image: block.settings.image, sizes: '(min-width: 981px) 640px, 100vw' -%}
        </div>
      {%- endfor -%}
      {%- if slides.size > 1 -%}
        <div class="mzh-gallery__nav">
          <button type="button" class="mzh-round" data-mzh-prev aria-label="Previous image">←</button>
          <button type="button" class="mzh-round" data-mzh-next aria-label="Next image">→</button>
        </div>
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="mzh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="mzh-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="mzh-copy">{{ section.settings.text }}</p>{%- endif -%}
      {%- if points.size > 0 -%}
        <div class="mzh-points">
          {%- for block in points -%}
            <div class="mzh-point" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title }}</strong>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mezzame proof",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "why" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Mezzame" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Proof Is in the Details" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "slide", "name": "Gallery image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }] },
    {
      "type": "point",
      "name": "Proof point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Small-batch craftsmanship" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Mezzame proof", "blocks": [{ "type": "slide" }, { "type": "point" }] }]
}
{% endschema %}
