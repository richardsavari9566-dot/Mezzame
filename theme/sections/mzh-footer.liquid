{%- comment -%} Mezzame footer: brand column plus up to three menu / text columns, with policy links. {%- endcomment -%}
<div class="mzh mzh-footer">
  <div class="mzh-container">
    <div class="mzh-footer__grid">
      <div>
        <div class="mzh-footer__brand">{{ section.settings.brand | default: shop.name }}</div>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.menu.links.size > 0 -%}
                <ul>
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'text' -%}
              {{ block.settings.text }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="mzh-footer__bottom">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- for policy in shop.policies -%}
          · <a href="{{ policy.url }}">{{ policy.title }}</a>
        {%- endfor -%}
      </span>
      {%- if section.settings.tagline != blank -%}<span>{{ section.settings.tagline }}</span>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mezzame footer",
  "max_blocks": 3,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "info": "Defaults to the store name." },
    { "type": "textarea", "id": "text", "label": "Brand text" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Proof, Not Promises." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Mezzame footer", "blocks": [{ "type": "menu" }, { "type": "menu" }, { "type": "text" }] }]
}
{% endschema %}
