{%- comment -%} Instagram grid. Only tiles with an image are shown; hidden when none have one. {%- endcomment -%}
{%- liquid
  assign tile_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign tile_count = tile_count | plus: 1
    endif
  endfor
-%}
{%- if tile_count > 0 or request.design_mode -%}
  <section class="mzh mzh-section mzh--alt">
    <div class="mzh-container">
      <div class="mzh-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="mzh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
          <h2 class="mzh-title">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.link_label != blank and section.settings.profile_url != blank -%}
          <a class="mzh-link" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
      <div class="mzh-insta">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank or request.design_mode -%}
            <a
              class="mzh-insta__tile"
              href="{{ block.settings.link | default: section.settings.profile_url | default: '#' }}"
              target="_blank"
              rel="noopener"
              {{ block.shopify_attributes }}
            >
              {%- render 'mzh-image', image: block.settings.image, sizes: '(min-width: 981px) 200px, (min-width: 641px) 33vw, 50vw' -%}
              <span class="visually-hidden">Open on Instagram</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Mezzame Instagram",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@mezzame" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh From Instagram" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile URL" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Follow Mezzame ↗" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Post link" }
      ]
    }
  ],
  "presets": [{ "name": "Mezzame Instagram", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
